# ============================================================
#  Gastos Generales · variables de entorno
#  Copiá este archivo a `.env` para probar en local, o cargá
#  las mismas variables en el panel del servidor (Render).
# ============================================================

# ---------- Obligatorios para recibir comprobantes ----------
# Lo que te da @BotFather cuando creás el bot de Telegram
TELEGRAM_BOT_TOKEN=123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw

# Clave que vas a usar para vincular tu número desde el celular:
#   /vincular mi-clave-secreta
BOT_CLAVE=cambia-esta-clave

# ---------- Seguridad del dashboard ----------
# Sin esto, cualquiera que conozca la URL podría ver tus gastos.
APP_PASSWORD=otra-clave-secreta

# ---------- Servidor ----------
# URL pública (la que te da Render). Si la definís se usa webhook,
# que es el modo correcto en producción. Si la dejás vacía, el
# servidor recibe los mensajes en modo polling (sirve para probar
# en local, sin túneles).
PUBLIC_URL=https://gastos-generales.onrender.com

# Opcional: si ya conocés tu chat ID de Telegram, vinculalo directo
# TELEGRAM_CHAT_ID=549115555555

# Opcional: dónde guardar los datos y la caché de OCR
# DATA_FILE=/var/data/estado.json
# TESSERACT_CACHE=/var/data/ocr

# Opcional: si usás un proxy propio para la API de Telegram
# TELEGRAM_API_BASE=https://api.telegram.org
